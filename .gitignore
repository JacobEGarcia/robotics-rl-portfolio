# Third-party assets — fetched, not vendored. See scripts/fetch_assets.sh
# MuJoCo Menagerie is 2.3 GB and is itself a git repository; DROID episodes
# belong to the DROID dataset and are redistributable but pointless to mirror.
assets/menagerie/
assets/data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Run artifacts are NOT ignored — runs/ holds the JSONL logs and checkpoints
# that back every number on the site, and they total ~1.2 MB. Reproducibility
# claims are worth more than a slightly smaller repository.

# S8 — regenerable bulk artifacts. The corpus is ~800 MB and fully
# reproducible from data_engine.py + the seed ranges documented there;
# per-run checkpoints of the 70-cell sweep total ~500 MB. The JSONL logs
# and result.json files that back the published numbers ARE committed.
s8_scaling/corpus/
s8_scaling/collection.log
s8_scaling/tools/*.png
s8_scaling/tools/*.mp4
runs/*_s8_bc_*/policy.pt
runs/*_s8_transfer_*/policy.pt

# MuJoCo drops this next to the working directory when a sim goes unstable.
# The instability itself is recorded in the run JSON (parity.Trajectory.extra).
MUJOCO_LOG.TXT
s10_gpu_scaling/results/*smoke*.json

# Training checkpoints are regenerable and per-session. Shipping one is worse
# than useless: the Colab notebooks run --resume, which would find a committed
# smoke checkpoint and silently continue a 32-step run.
s2_inhand/checkpoints/
s3_domain_rand/checkpoints/
